{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "RLYEH_PNAKOTIC_BUILD_TESTS": "ON",
        "RLYEH_PNAKOTIC_BUILD_APP": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mac-gui-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_PREFIX_PATH": "${sourceDir}/deps/Qt/6.11.1/darwin-universal",
        "RLYEH_PNAKOTIC_BUILD_APP": "ON"
      }
    },
    {
      "name": "debug-mac-gui",
      "displayName": "macOS Universal GUI (Debug)",
      "inherits": "mac-gui-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-mac-gui",
      "displayName": "macOS Universal GUI (Release)",
      "inherits": "mac-gui-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-gui-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/deps/Qt/6.11.1/linux-x86_64",
        "RLYEH_PNAKOTIC_BUILD_APP": "ON"
      }
    },
    {
      "name": "debug-linux-gui",
      "displayName": "Linux x86_64 GUI (Debug)",
      "inherits": "linux-gui-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-linux-gui",
      "displayName": "Linux x86_64 GUI (Release)",
      "inherits": "linux-gui-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug-mac-gui",
      "configurePreset": "debug-mac-gui"
    },
    {
      "name": "release-mac-gui",
      "configurePreset": "release-mac-gui"
    },
    {
      "name": "debug-linux-gui",
      "configurePreset": "debug-linux-gui"
    },
    {
      "name": "release-linux-gui",
      "configurePreset": "release-linux-gui"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-mac-gui",
      "configurePreset": "debug-mac-gui",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-mac-gui",
      "configurePreset": "release-mac-gui",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-linux-gui",
      "configurePreset": "debug-linux-gui",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-linux-gui",
      "configurePreset": "release-linux-gui",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
