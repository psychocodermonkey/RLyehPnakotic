find_package(Git REQUIRED)

execute_process(
  COMMAND "${GIT_EXECUTABLE}" rev-parse --show-toplevel
  WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
  OUTPUT_VARIABLE PNAKOTIC_GIT_ROOT
  OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE PNAKOTIC_GIT_RESULT
)
if(NOT PNAKOTIC_GIT_RESULT EQUAL 0 OR NOT PNAKOTIC_GIT_ROOT STREQUAL PROJECT_SOURCE_DIR)
  message(FATAL_ERROR "Pnakotic build version requires its own Git checkout")
endif()

execute_process(
  COMMAND "${GIT_EXECUTABLE}" rev-parse --verify HEAD
  WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
  OUTPUT_VARIABLE PNAKOTIC_COMMIT_HASH
  OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE PNAKOTIC_GIT_RESULT
)
if(NOT PNAKOTIC_GIT_RESULT EQUAL 0 OR NOT PNAKOTIC_COMMIT_HASH MATCHES "^[0-9a-fA-F]+$")
  message(FATAL_ERROR "Could not read Pnakotic's full Git commit hash")
endif()

execute_process(
  COMMAND "${GIT_EXECUTABLE}" show -s --format=%ct HEAD
  WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
  OUTPUT_VARIABLE PNAKOTIC_COMMIT_TIMESTAMP
  OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE PNAKOTIC_GIT_RESULT
)
if(NOT PNAKOTIC_GIT_RESULT EQUAL 0 OR NOT PNAKOTIC_COMMIT_TIMESTAMP MATCHES "^[0-9]+$")
  message(FATAL_ERROR "Could not read Pnakotic's Git committer timestamp")
endif()

# Git stores the committer's timezone-aware date as an absolute Unix timestamp.
# The generated C++ header selects its UTC calendar day before encoding.
set(PNAKOTIC_GENERATED_DIR "${PROJECT_BINARY_DIR}/generated")
file(MAKE_DIRECTORY "${PNAKOTIC_GENERATED_DIR}")
configure_file(
  "${PROJECT_SOURCE_DIR}/cmake/PnakoticBuildVersion.h.in"
  "${PNAKOTIC_GENERATED_DIR}/PnakoticBuildVersion.h"
  @ONLY
)

# Reconfigure when HEAD changes, including commits on a checked-out branch.
execute_process(
  COMMAND "${GIT_EXECUTABLE}" rev-parse --git-path HEAD
  WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
  OUTPUT_VARIABLE PNAKOTIC_GIT_HEAD_PATH
  OUTPUT_STRIP_TRAILING_WHITESPACE
)
get_filename_component(PNAKOTIC_GIT_HEAD_PATH "${PNAKOTIC_GIT_HEAD_PATH}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PNAKOTIC_GIT_HEAD_PATH}")

execute_process(
  COMMAND "${GIT_EXECUTABLE}" symbolic-ref -q HEAD
  WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
  OUTPUT_VARIABLE PNAKOTIC_GIT_BRANCH_REF
  OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE PNAKOTIC_GIT_RESULT
)
if(PNAKOTIC_GIT_RESULT EQUAL 0)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" rev-parse --git-path "${PNAKOTIC_GIT_BRANCH_REF}"
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    OUTPUT_VARIABLE PNAKOTIC_GIT_BRANCH_PATH
    OUTPUT_STRIP_TRAILING_WHITESPACE
  )
  get_filename_component(PNAKOTIC_GIT_BRANCH_PATH "${PNAKOTIC_GIT_BRANCH_PATH}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PNAKOTIC_GIT_BRANCH_PATH}")
endif()
